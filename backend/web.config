<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Map all requests for server.js through iisnode -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- URL Rewrite Rules: Serve static files if they exist; otherwise, route to server.js -->
    <rewrite>
      <rules>
        <rule name="StaticContent" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="true" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="DynamicContent">
          <match url="^(.*)$" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Disable logging to avoid permission issues -->
    <iisnode loggingEnabled="true" devErrorsEnabled="false" />
  </system.webServer>
</configuration>
